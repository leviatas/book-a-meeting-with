DATABASE_URL="file:./dev.db"

# OAuth client ID de Google Cloud Console (Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Para la integración con Google Calendar (opcional).
GOOGLE_CLIENT_SECRET=""

# String largo al azar para firmar los JWT. Generalo con: openssl rand -hex 32
JWT_SECRET="change-me"

# Emails separados por coma que quedan como superadmin en el primer login.
ADMIN_EMAILS="leviatas@gmail.com"

# Vacío = registro abierto. Ej: "ana@gmail.com,@miempresa.com"
ALLOWED_EMAILS=

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Mails (opcional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
