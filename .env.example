# Lo usa `docker compose` para buildear y correr ambos servicios.
# Copialo a .env antes de arrancar: cp .env.example .env

# OAuth client ID de Google Cloud Console (Credentials > OAuth 2.0 Client IDs).
# Lo usan el backend (para verificar los ID token) y el build del frontend
# (para el botón de login).
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Client secret del MISMO Client ID. Sólo lo usa la integración con Google
# Calendar (flujo OAuth con refresh token). Sin esto la app anda, pero no se
# puede conectar Calendar. En el Client ID agregá además, en "Authorized
# redirect URIs":  <CLIENT_ORIGIN>/api/google/callback
GOOGLE_CLIENT_SECRET=""

# Opcional: forzar otra redirect URI (por defecto CLIENT_ORIGIN/api/google/callback).
# GOOGLE_REDIRECT_URI=""

# String largo al azar para firmar los JWT. Generalo con: openssl rand -hex 32
JWT_SECRET="change-me"

# Emails separados por coma que quedan como superadmin en el primer login.
ADMIN_EMAILS="leviatas@gmail.com"

# Quién puede registrarse. Vacío = cualquiera con cuenta de Google (como
# Calendly). Si tiene algo, sólo esos emails o dominios, separados por coma,
# además de ADMIN_EMAILS. Ej: ALLOWED_EMAILS="ana@gmail.com,@miempresa.com"
ALLOWED_EMAILS=

# Origen público desde el que se sirve el cliente (CORS del backend). Tiene que
# coincidir EXACTO con la URL desde la que el browser carga la app.
CLIENT_ORIGIN="http://localhost:8080"

# Puerto del host donde se publica el cliente (nginx).
CLIENT_PORT=8080

# Zona horaria del proceso del backend (sólo logs: la agenda usa la zona de
# cada horario).
TZ="America/Argentina/Buenos_Aires"

# Sólo si corrés el profile "cloudflare". Creá el túnel en
# https://one.dash.cloudflare.com/ -> Networks -> Tunnels -> Create a tunnel
# -> connector "Docker", y copiá el token del comando que te muestra (la
# cadena larga después de --token).
CLOUDFLARE_TUNNEL_TOKEN=

# Para no pasar --profile en cada comando, descomentá:
# COMPOSE_PROFILES=cloudflare

# Mails de confirmación / reprogramación / cancelación (con .ics adjunto).
# Opcional: si SMTP_HOST está vacío no se manda nada. Con Google Calendar
# conectado, Google ya le manda la invitación al invitado.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true y una
# "contraseña de aplicación" en SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Book a Meeting <agenda@tudominio.com>"
